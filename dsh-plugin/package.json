{
  "name": "dsh-plugin-session-bridge",
  "version": "2.10.2",
  "private": true,
  "description": "跨会话经验桥：同一工作区的 DSH 会话自动同步通用注意事项、经验教训与任务交接；右侧栏看板可查看规矩、送达/接受情况并管理群组",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
